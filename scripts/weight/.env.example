# Copy this file to .env and fill in your values.
# .env is gitignored — never commit your actual API key.

# Required: your Tinker API key (get it from https://tinkerlabs.ai)
TINKER_API_KEY=tml-your-key-here

# Optional: override the Tinker API endpoint.
# Leave commented out to use the production cloud API.
# Uncomment and set to a local SkyRL server URL for local testing:
# TINKER_BASE_URL=http://localhost:8002
