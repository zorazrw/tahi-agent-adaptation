              "content": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>WebArena Performance Trend</title>\n    <style>\n        * {\n            margin: 0;\n            padding: 0;\n            box-sizing: border-box;\n        }\n\n        body {\n            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Arial, sans-serif;\n            background: white;\n            padding: 0;\n            margin: 0;\n            display: flex;\n            justify-content: center;\n            align-items: center;\n            min-height: 100vh;\n        }\n\n        .chart-container {\n            width: 1600px;\n            height: 900px;\n            position: relative;\n            padding: 40px;\n            box-sizing: border-box;\n        }\n\n        svg {\n            width: 100%;\n            height: 100%;\n        }\n\n        .axis-label {\n            font-size: 42px;\n            fill: #444;\n            font-weight: 500;\n        }\n\n        .y-axis-title {\n            font-size: 42px;\n            fill: #444;\n            font-weight: 500;\n        }\n\n        .data-point {\n            fill: #2d8659;\n            opacity: 0.75;\n        }\n\n        .y-axis-line {\n            stroke: #ddd;\n            stroke-width: 1.5;\n        }\n\n        .x-axis-line {\n            stroke: #ddd;\n            stroke-width: 1.5;\n        }\n    </style>\n</head>\n<body>\n    <div class=\"chart-container\">\n        <svg viewBox=\"0 0 1600 850\" preserveAspectRatio=\"xMidYMid meet\">\n            <!-- Y-axis -->\n            <line class=\"y-axis-line\" x1=\"150\" y1=\"80\" x2=\"150\" y2=\"680\" />\n\n            <!-- X-axis -->\n            <line class=\"x-axis-line\" x1=\"150\" y1=\"680\" x2=\"1520\" y2=\"680\" />\n\n            <!-- Y-axis title -->\n            <text class=\"y-axis-title\" x=\"30\" y=\"380\" text-anchor=\"middle\" transfo