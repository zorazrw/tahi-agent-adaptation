100%;\n            height: 80px;\n        }\n\n        .x-label {\n            position: absolute;\n            font-size: 42px;\n            color: #333;\n            font-weight: 500;\n            text-align: center;\n        }\n\n        .y-axis-label {\n            position: absolute;\n            left: -240px;\n            top: 50%;\n            transform-origin: center center;\n            transform: translateY(-50%) rotate(-90deg);\n            font-size: 42px;\n            color: #333;\n            white-space: nowrap;\n        }\n\n        .bar-group {\n            position: absolute;\n            bottom: 0;\n            display: flex;\n            gap: 10px;\n            align-items: flex-end;\n        }\n\n        .bar {\n            width: 70px;\n            position: relative;\n            transition: opacity 0.2s;\n        }\n\n        .bar:hover {\n            opacity: 0.8;\n        }\n\n        .bar-fill {\n            width: 100%;\n            height: 100%;\n        }\n\n        .bar-value {\n            position: absolute;\n            top: -50px;\n            left: 50%;\n            transform: translateX(-50%);\n            font-size: 38px;\n            font-weight: 600;\n            color: #333;\n            white-space: nowrap;\n        }\n\n        .group1 { left: 120px; }\n        .group2 { left: 450px; }\n        .group3 { left: 780px; }\n    </style>\n</head>\n<body class=\"\">\n    <div class=\"chart-container\">\n        <div class=\"chart-title\">Mind2Web</div>\n\n        <div class=\"legend\">\n            <div class=\"legend-item\">\n                <div class=\"legend-color\" style=\"background-color: #888888;\"></div>\n                <span>MindAct</span>\n            </div>\n            <div class=\"legend-item\">\n                <div class=\"legend-color\" style=\"background-color: #5CB85C;\"></div>\n                <span>AWM-offline</span>\n            </div>\n            <div class=\"legend-item\">\n                <div class=\"l