              "path": "webarena_benchmark.html",
              "content": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>WebArena Benchmark Results</title>\n    <style>\n        * {\n            margin: 0;\n            padding: 0;\n            box-sizing: border-box;\n        }\n\n        body {\n            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;\n            background: #fafafa;\n            padding: 40px 20px;\n            display: flex;\n            justify-content: center;\n            align-items: center;\n            min-height: 100vh;\n        }\n\n        .container {\n            background: white;\n            border-radius: 16px;\n            padding: 40px;\n            box-shadow: 0 4px 20px rgba(0,0,0,0.08);\n            max-width: 900px;\n            width: 100%;\n        }\n\n        h1 {\n            font-size: 24px;\n            font-weight: 600;\n            color: #1a1a1a;\n            margin-bottom: 8px;\n            text-align: center;\n        }\n\n        .subtitle {\n            font-size: 14px;\n            color: #666;\n            text-align: center;\n            margin-bottom: 32px;\n        }\n\n        .chart-container {\n            position: relative;\n            width: 100%;\n            height: 450px;\n        }\n\n        .bar {\n            transition: all 0.3s ease;\n            cursor: pointer;\n        }\n\n        .bar:hover {\n            opacity: 0.85;\n        }\n\n        .bar-label {\n            font-size: 12px;\n            fill: #333;\n            font-weight: 500;\n        }\n\n        .axis-label {\n            font-size: 11px;\n            fill: #666;\n        }\n\n        .axis-title {\n            font-size: 13px;\n            fill: #333;\n            font-weight: 500;\n        }\n\n        .grid-line {\n            stroke: #e0e0e0;\n            stroke-width: 1;\n        }\n\n        .value-label {\n            font-size: 12px;\n            font-weight: 600;\n            fill: #333;\n        }\n\n        .legend {\n            display: flex;\n            justify-content: center;\n            gap: 24px;\n            margin-top: 24px;\n            flex-wrap: wrap;\n        }\n\n        .legend-item {\n            display: flex;\n            align-items: center;\n            gap: 8px;\n            font-size: 13px;\n            color: #333;\n        }\n\n        .legend-box {\n            width: 16px;\n            height: 16px;\n            border-radius: 3px;\n        }\n\n        .tooltip {\n            position: absolute;\n            background: rgba(0, 0, 0, 0.9);\n            color: white;\n            padding: 8px 12px;\n            border-radius: 6px;\n            font-size: 13px;\n            pointer-events: none;\n            opacity: 0;\n            transition: opacity 0.2s;\n            white-space: nowrap;\n        }\n    </style>\n</head>\n<body>\n    <div class=\"container\">\n        <h1>WebArena Benchmark Results</h1>\n        <p class=\"subtitle\">Success Rate (%) Comparison</p>\n\n        <div class=\"chart-container\">\n            <svg id=\"chart\" width=\"100%\" height=\"100%\" viewBox=\"0 0 800 400\">\n                <!-- Grid lines -->\n                <line x1=\"80\" y1=\"50\" x2=\"80\" y2=\"320\" stroke=\"#ddd\" stroke-width=\"2\"/>\n                <line x1=\"80\" y1=\"320\" x2=\"750\" y2=\"320\" stroke=\"#ddd\" stroke-width=\"2\"/>\n\n                <!-- Y-axis grid lines -->\n                <line class=\"grid-line\" x1=\"80\" y1=\"320\" x2=\"750\" y2=\"320\"/>\n                <line class=\"grid-line\" x1=\"80\" y1=\"252.5\" x2=\"750\" y2=\"252.5\"/>\n                <line class=\"grid-line\" x1=\"80\" y1=\"185\" x2=\"750\" y2=\"185\"/>\n                <line class=\"grid-line\" x1=\"80\" y1=\"117.5\" x2=\"750\" y2=\"117.5\"/>\n                <line class=\"grid-line\" x1=\"80\" y1=\"50\" x2=\"750\" y2=\"50\"/>\n\n                <!-- Y-axis labels -->\n                <text class=\"axis-label\" x=\"70\" y=\"325\" text-anchor=\"end\">0</text>\n                <text class=\"axis-label\" x=\"70\" y=\"257\" text-anchor=\"end\">10</text>\n                <text class=\"axis-label\" x=\"70\" y=\"189\" text-anchor=\"end\">20</text>\n                <text class=\"axis-label\" x=\"70\" y=\"121\" text-anchor=\"end\">30</text>\n                <text class=\"axis-label\" x=\"70\" y=\"54\" text-anchor=\"end\">40</text>\n\n                <!-- Y-axis title -->\n                <text class=\"axis-title\" x=\"20\" y=\"185\" text-anchor=\"middle\" transform=\"rotate(-90 20 185)\">Success Rate (%)</text>\n\n                <!-- Bars -->\n                <!-- GPT-4o -->\n                <rect class=\"bar\" data-name=\"GPT-4o\" data-value=\"14.9\" data-category=\"Baseline Method\"\n                      x=\"100\" y=\"219.325\" width=\"90\" height=\"100.675\"\n                      fill=\"#FFB366\" rx=\"4\"/>\n                <text class=\"value-label\" x=\"145\" y=\"210\" text-anchor=\"middle\">14.9</text>\n                <text class=\"bar-label\" x=\"145\" y=\"345\" text-anchor=\"middle\">GPT-4o</text>\n\n                <!-- AutoEval -->\n                <rect class=\"bar\" data-name=\"AutoEval\" data-value=\"20.2\" data-category=\"Baseline Method\"\n                      x=\"210\" y=\"174.6\" width=\"90\" height=\"145.4\"\n                      fill=\"#FFB366\" rx=\"4\"/>\n                <text class=\"value-label\" x=\"255\" y=\"165\" text-anchor=\"middle\">20.2</text>\n                <text class=\"bar-label\" x=\"255\" y=\"345\" text-anchor=\"middle\">AutoEval</text>\n\n                <!-- BrowserGym -->\n                <rect class=\"bar\" data-name=\"BrowserGym\" data-value=\"23.5\" data-category=\"Baseline Method\"\n                      x=\"320\" y=\"147.25\" width=\"90\" height=\"172.75\"\n                      fill=\"#FFB366\" rx=\"4\"/>\n                <text class=\"value-label\" x=\"365\" y=\"138\" text-anchor=\"middle\">23.5</text>\n                <text class=\"bar-label\" x=\"365\" y=\"345\" text-anchor=\"middle\">BrowserGym</text>\n\n                <!-- BrowserGym axtree -->\n                <rect class=\"bar\" data-name=\"BrowserGym axtree\" data-value=\"15.0\" data-category=\"Baseline Method\"\n                      x=\"430\" y=\"219.0\" width=\"90\" height=\"101.0\"\n                      fill=\"#FFB366\" rx=\"4\"/>\n                <text class=\"value-label\" x=\"475\" y=\"210\" text-anchor=\"middle\">15.0</text>\n                <text class=\"bar-label\" x=\"475\" y=\"345\" text-anchor=\"middle\">BrowserGym</text>\n                <text class=\"bar-label\" x=\"475\" y=\"360\" text-anchor=\"middle\">axtree</text>\n\n                <!-- AWM (Our Method) -->\n                <rect class=\"bar\" data-name=\"AWM\" data-value=\"35.5\" data-category=\"Our Method\"\n                      x=\"540\" y=\"54.75\" width=\"90\" height=\"265.25\"\n                      fill=\"#FF6B35\" rx=\"4\"/>\n                <text class=\"value-label\" x=\"585\" y=\"45\" text-anchor=\"middle\">35.5</text>\n                <text class=\"bar-label\" x=\"585\" y=\"345\" text-anchor=\"middle\" font-weight=\"600\">AWM</text>\n\n                <!-- Step (Human) -->\n                <rect class=\"bar\" data-name=\"Step\" data-value=\"33.0\" data-category=\"Human Baseline\"\n                      x=\"650\" y=\"75.5\" width=\"90\" height=\"244.5\"\n                      fill=\"#FFA366\" rx=\"4\"/>\n                <text class=\"value-label\" x=\"695\" y=\"66\" text-anchor=\"middle\">33.0</text>\n                <text class=\"bar-label\" x=\"695\" y=\"345\" text-anchor=\"middle\">Step</text>\n                <text class=\"bar-label\" x=\"695\" y=\"360\" text-anchor=\"middle\">(Human)</text>\n            </svg>\n\n            <div class=\"tooltip\" id=\"tooltip\"></div>\n        </div>\n\n        <div class=\"legend\">\n            <div class=\"legend-item\">\n                <div class=\"legend-box\" style=\"background: #FFB366;\"></div>\n                <span>Baseline Methods</span>\n            </div>\n            <div class=\"legend-item\">\n                <div class=\"legend-box\" style=\"background: #FF6B35;\"></div>\n                <span>Our Method (AWM)</span>\n            </div>\n            <div class=\"legend-item\">\n                <div class=\"legend-box\" style=\"background: #FFA366;\"></div>\n                <span>Human Baseline</span>\n            </div>\n        </div>\n    </div>\n\n    <script>\n        // Interactive hover effects\n        const bars = document.querySelectorAll('.bar');\n        const tooltip = document.getElementById('tooltip');\n\n        bars.forEach(bar => {\n            bar.addEventListener('mouseenter', (e) => {\n                const name = bar.getAttribute('data-name');\n                const value = bar.getAttribute('data-value');\n                const category = bar.getAttribute('data-category');\n\n                tooltip.innerHTML = `<strong>${name}</strong><br>${category}<br>Success Rate: ${value}%`;\n                tooltip.style.opacity = '1';\n            });\n\n            bar.addEventListener('mousemove', (e) => {\n                const rect = document.querySelector('.container').getBoundingClientRect();\n                tooltip.style.left = (e.clientX - rect.left + 15) + 'px';\n                tooltip.style.top = (e.clientY - rect.top - 15) + 'px';\n            });\n\n            bar.addEventListener('mouseleave', () => {\n                tooltip.style.opacity = '0';\n            });\n        });\n    </script>\n</body>\n</html>\n",
