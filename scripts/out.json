              "content": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>WebArena Performance Trend</title>\n    <style>\n        * {\n            margin: 0;\n            padding: 0;\n            box-sizing: border-box;\n        }\n\n        body {\n            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Arial, sans-serif;\n            background: white;\n            padding: 60px;\n            display: flex;\n            justify-content: center;\n            align-items: center;\n            min-height: 100vh;\n        }\n\n        .chart-container {\n            width: 1400px;\n            height: 700px;\n            position: relative;\n        }\n\n        svg {\n            width: 100%;\n            height: 100%;\n        }\n\n        .axis-label {\n            font-size: 42px;\n            fill: #333;\n            font-weight: 500;\n        }\n\n        .value-label {\n            font-size: 38px;\n            fill: #666;\n            font-weight: 400;\n        }\n\n        .line-path {\n            fill: none;\n            stroke: #2d8659;\n            stroke-width: 3;\n            stroke-linecap: round;\n            stroke-linejoin: round;\n        }\n\n        .data-point {\n            fill: #2d8659;\n        }\n\n        .y-axis-line {\n            stroke: #ddd;\n            stroke-width: 1.5;\n        }\n\n        .x-axis-line {\n            stroke: #ddd;\n            stroke-width: 1.5;\n        }\n    </style>\n</head>\n<body>\n    <div class=\"chart-container\">\n        <svg viewBox=\"0 0 1400 700\" preserveAspectRatio=\"xMidYMid meet\">\n            <!-- Y-axis -->\n            <line class=\"y-axis-line\" x1=\"150\" y1=\"80\" x2=\"150\" y2=\"580\" />\n\n            <!-- X-axis -->\n            <line class=\"x-axis-line\" x1=\"150\" y1=\"580\" x2=\"1320\" y2=\"580\" />\n\n            <!-- Y-axis labels (scores) -->\n            <text class=\"value-label\" x=\"130\" y=\"585\" text-anchor=\"end\">0</text>\n            <text class=\"value-label\" x=\"130\" y=\"460\" text-anchor=\"end\">20</text>\n            <text class=\"value-label\" x=\"130\" y=\"335\" text-anchor=\"end\">40</text>\n            <text class=\"value-label\" x=\"130\" y=\"210\" text-anchor=\"end\">60</text>\n            <text class=\"value-label\" x=\"130\" y=\"85\" text-anchor=\"end\">80</text>\n\n            <!-- Data points coordinates:\n                 Mar 2023: 8.87  -> x=240,  y=524 (8.87/80 * 500 = 55.4 from top)\n                 Sep 2023: 7.14  -> x=456,  y=535 (7.14/80 * 500 = 44.6 from top)\n                 Apr 2024: 33.5  -> x=672,  y=371 (33.5/80 * 500 = 209.4 from top)\n                 Aug 2024: 57.1  -> x=888,  y=223 (57.1/80 * 500 = 356.9 from top)\n                 Jan 2025: 58.1  -> x=1104, y=217 (58.1/80 * 500 = 363.1 from top)\n                 Dec 2025: 71.2  -> x=1320, y=135 (71.2/80 * 500 = 445 from top)\n            -->\n\n            <!-- Line connecting all points -->\n            <path class=\"line-path\" d=\"M 240 524.6 L 456 535.4 L 672 370.6 L 888 223.1 L 1104 216.9 L 1320 135\" />\n\n            <!-- Data point circles -->\n            <circle class=\"data-point\" cx=\"240\" cy=\"524.6\" r=\"8\" />\n            <circle class=\"data-point\" cx=\"456\" cy=\"535.4\" r=\"8\" />\n            <circle class=\"data-point\" cx=\"672\" cy=\"370.6\" r=\"8\" />\n            <circle class=\"data-point\" cx=\"888\" cy=\"223.1\" r=\"8\" />\n            <circle class=\"data-point\" cx=\"1104\" cy=\"216.9\" r=\"8\" />\n            <circle class=\"data-point\" cx=\"1320\" cy=\"135\" r=\"8\" />\n\n            <!-- X-axis date labels -->\n            <text class=\"axis-label\" x=\"240\" y=\"640\" text-anchor=\"middle\">Mar</text>\n            <text class=\"axis-label\" x=\"240\" y=\"680\" text-anchor=\"middle\">2023</text>\n\n            <text class=\"axis-label\" x=\"456\" y=\"640\" text-anchor=\"middle\">Sep</text>\n            <text class=\"axis-label\" x=\"456\" y=\"680\" text-anchor=\"middle\">2023</text>\n\n            <text class=\"axis-label\" x=\"672\" y=\"640\" text-anchor=\"middle\">Apr</text>\n            <text class=\"axis-label\" x=\"672\" y=\"680\" text-anchor=\"middle\">2024</text>\n\n            <text class=\"axis-label\" x=\"888\" y=\"640\" text-anchor=\"middle\">Aug</text>\n            <text class=\"axis-label\" x=\"888\" y=\"680\" text-anchor=\"middle\">2024</text>\n\n            <text class=\"axis-label\" x=\"1104\" y=\"640\" text-anchor=\"middle\">Jan</text>\n            <text class=\"axis-label\" x=\"1104\" y=\"680\" text-anchor=\"middle\">2025</text>\n\n            <text class=\"axis-label\" x=\"1320\" y=\"640\" text-anchor=\"middle\">Dec</text>\n            <text class=\"axis-label\" x=\"1320\" y=\"680\" text-anchor=\"middle\">2025</text>\n\n            <!-- Score value labels at each point -->\n            <text class=\"value-label\" x=\"240\" y=\"510\" text-anchor=\"middle\" fill=\"#2d8659\">8.9</text>\n            <text class=\"value-label\" x=\"456\" y=\"520\" text-anchor=\"middle\" fill=\"#2d8659\">7.1</text>\n            <text class=\"value-label\" x=\"672\" y=\"355\" text-anchor=\"middle\" fill=\"#2d8659\">33.5</text>\n            <text class=\"value-label\" x=\"888\" y=\"208\" text-anchor=\"middle\" fill=\"#2d8659\">57.1</text>\n            <text class=\"value-label\" x=\"1104\" y=\"202\" text-anchor=\"middle\" fill=\"#2d8659\">58.1</text>\n            <text class=\"value-label\" x=\"1320\" y=\"120\" text-anchor=\"middle\" fill=\"#2d8659\">71.2</text>\n        </svg>\n    </div>\n</body>\n</html>\n",
