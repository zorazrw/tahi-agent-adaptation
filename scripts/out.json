.1, type: \"awm\" },\n                    { name: \"AWM-online\", value: 43.6, type: \"awm-online\" }\n                ]\n            },\n            {\n                split: \"Cross-Website\",\n                methods: [\n                    { name: \"MindAct\", value: 30.1, type: \"baseline\" },\n                    { name: \"AWM-offline\", value: 33.7, type: \"awm\" },\n                    { name: \"AWM-online\", value: 33.9, type: \"awm-online\" }\n                ]\n            },\n            {\n                split: \"Cross-Domain\",\n                methods: [\n                    { name: \"MindAct\", value: 26.4, type: \"baseline\" },\n                    { name: \"AWM-offline\", value: 32.6, type: \"awm\" },\n                    { name: \"AWM-online\", value: 35.5, type: \"awm-online\" }\n                ]\n            }\n        ];\n\n        // Color scheme\n        const colors = {\n            \"baseline\": \"#888888\",     // Gray for baseline\n            \"awm\": \"#5CB85C\",          // Medium green for AWM-offline\n            \"awm-online\": \"#2E7D32\"    // Darker green for AWM-online\n        };\n\n        // Dimensions and margins\n        const margin = { top: 20, right: 150, bottom: 80, left: 60 };\n        const width = 1000 - margin.left - margin.right;\n        const height = 600 - margin.top - margin.bottom;\n\n        // Create SVG\n        const svg = d3.select(\"#chart\")\n            .attr(\"width\", width + margin.left + margin.right)\n            .attr(\"height\", height + margin.top + margin.bottom)\n            .append(\"g\")\n            .attr(\"transform\", `translate(${margin.left},${margin.top})`);\n\n        // Scales\n        const x0 = d3.scaleBand()\n            .domain(data.map(d => d.split))\n            .range([0, width])\n            .padding(0.2);\n\n        const x1 = d3.scaleBand()\n            .domain(data[0].methods.map(d => d.name))\n            .range([0, x0.bandwidth()])\n            .padding(0.1);\n\n        const y = d3.scaleLinear()\n            .domain([0, 50])\n            .range([height, 0]);\n\n        // X-axis\n        svg.append(\"g\")\n            .attr(\"class\", \"axis\")\n            .attr(\"transform\", `translate(0,${height})`)\n            .call(d3.axisBottom(x0))\n            .selectAll(\"text\")\n            .style(\"font-size\", \"20px\")\n            .style(\"font-weight\", \"500\");\n\n        // Y-axis\n        svg.append(\"g\")\n            .attr(\"class\", \"axis\")\n            .call(d3.axisLeft(y).ticks(5))\n            .selectAll(\"text\")\n            .style(\"font-size\", \"20px\");\n\n        // Create groups for each split\n        const splitGroups = svg.selectAll(\".split-group\")\n            .data(data)\n            .enter()\n            .append(\"g\")\n            .attr(\"class\", \"split-group\")\n            .attr(\"transform\", d => `translate(${x0(d.split)},0)`);\n\n        // Create bars\n        splitGroups.selectAll(\".bar\")\n            .data(d => d.methods)\n            .enter()\n            .append(\"rect\")\n            .attr(\"class\", \"bar\")\n            .attr(\"x\", d => x1(d.name))\n            .attr(\"y\", d => y(d.value))\n            .attr(\"width\", x1.bandwidth())\n            .attr(\"height\", d => height - y(d.value))\n            .attr(\"fill\", d => colors[d.type]);\n\n        // Add value labels on bars\n        splitGroups.selectAll(\".value-label\")\n            .data(d => d.methods)\n            .enter()\n            .append(\"text\")\n            .attr(\"class\", \"value-label\")\n            .attr(\"x\", d => x1(d.name) + x1.bandwidth() / 2)\n            .attr(\"y\", d => y(d.value) - 8)\n            .attr(\"text-anchor\", \"middle\")\n            .text(d => d.value);\n\n        // Legend\n        const legend = svg.append(\"g\")\n            .attr(\"class\", \"legend\")\n            .attr(\"transform\", `translate(${width - 120}, 20)`);\n\n        const legendData = [\n            { name: \"MindAct\", type: \"baseline\" },\n            { name: \"AWM-offline\", type: \"awm\" },\n            { name: \"AWM-online\", type: \"awm-online\" }\n        ];\n\n        const legendItems = legend.selectAll(\".legend-item\")\n            .data(legendData)\n            .enter()\n            .append(\"g\")\n            .attr(\"class\", \"legend-item\")\n            .attr(\"transform\", (d, i) => `translate(0, ${i * 30})`);\n\n        legendItems.append(\"rect\")\n            .attr(\"class\", \"legend-rect\")\n            .attr(\"width\", 20)\n            .attr(\"height\", 20)\n            .attr(\"fill\", d => colors[d.type]);\n\n        legendItems.append(\"text\")\n            .attr(\"class\", \"legend-text\")\n            .attr(\"x\", 28)\n            .attr(\"y\", 15)\n            .style(\"font-size\", \"18px\")\n            .text(d => d.name);\n\n        // Y-axis label\n        svg.append(\"text\")\n            .attr(\"transform\", \"rotate(-90)\")\n            .attr(\"y\", -45)\n            .attr(\"x\", -height / 2)\n            .attr(\"text-anchor\", \"middle\")\n            .style(\"font-size\", \"20px\")\n            .style(\"fill\", \"#333\")\n            .text(\"Performance\");\n    </script>\n</body>\n</html>\n",
