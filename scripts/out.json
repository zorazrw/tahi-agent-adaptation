              "content": "<!DOCTYPE html>\n<html lang=\"en\"><head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>Mind2Web Dataset Results</title>\n    <style>\n        body {\n            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, sans-serif;\n            margin: 0;\n            padding: 60px;\n            background-color: #ffffff;\n        }\n\n        .chart-container {\n            max-width: 1600px;\n            margin: 0 auto;\n        }\n\n        .chart-title {\n            font-size: 48px;\n            font-weight: bold;\n            text-align: center;\n            margin-bottom: 40px;\n            color: #333;\n        }\n\n        .legend {\n            display: flex;\n            justify-content: center;\n            gap: 40px;\n            margin-bottom: 40px;\n        }\n\n        .legend-item {\n            display: flex;\n            align-items: center;\n            gap: 12px;\n            font-size: 24px;\n            color: #333;\n        }\n\n        .legend-color {\n            width: 30px;\n            height: 30px;\n        }\n\n        .chart-area {\n            position: relative;\n            height: 900px;\n            border-left: 3px solid #333;\n            border-bottom: 3px solid #333;\n            margin-left: 100px;\n            margin-right: 100px;\n        }\n\n        .y-axis {\n            position: absolute;\n            left: -100px;\n            top: 0;\n            width: 80px;\n            height: 100%;\n        }\n\n        .y-tick {\n            position: absolute;\n            right: 0;\n            width: 100%;\n            text-align: right;\n            font-size: 28px;\n            color: #333;\n            padding-right: 15px;\n        }\n\n        .x-axis {\n            position: absolute;\n            bottom: -80px;\n            left: 0;\n            width: 100%;\n            height: 60px;\n        }\n\n        .x-label {\n            position: absolute;\n            font-size: 28px;\n            color: #333;\n            font-weight: 500;\n            text-align: center;\n        }\n\n        .y-axis-label {\n            position: absolute;\n            left: -85px;\n            top: 50%;\n            transform: translateY(-50%) rotate(-90deg);\n            font-size: 28px;\n            color: #333;\n            white-space: nowrap;\n        }\n\n        .bar-group {\n            position: absolute;\n            bottom: 0;\n            display: flex;\n            gap: 15px;\n            align-items: flex-end;\n        }\n\n        .bar {\n            width: 90px;\n            position: relative;\n            transition: opacity 0.2s;\n        }\n\n        .bar:hover {\n            opacity: 0.8;\n        }\n\n        .bar-fill {\n            width: 100%;\n            height: 100%;\n        }\n\n        .bar-value {\n            position: absolute;\n            top: -35px;\n            left: 50%;\n            transform: translateX(-50%);\n            font-size: 24px;\n            font-weight: 600;\n            color: #333;\n            white-space: nowrap;\n        }\n\n        .group1 { left: 120px; }\n        .group2 { left: 580px; }\n        .group3 { left: 1040px; }\n    </style>\n</head>\n<body class=\"\">\n    <div class=\"chart-container\">\n        <div class=\"chart-title\">Mind2Web</div>\n\n        <div class=\"legend\">\n            <div class=\"legend-item\">\n                <div class=\"legend-color\" style=\"background-color: #888888;\"></div>\n                <span>MindAct</span>\n            </div>\n            <div class=\"legend-item\">\n                <div class=\"legend-color\" style=\"background-color: #5CB85C;\"></div>\n                <span>AWM-offline</span>\n            </div>\n            <div class=\"legend-item\">\n                <div class=\"legend-color\" style=\"background-color: #2E7D32;\"></div>\n                <span>AWM-online</span>\n            </div>\n        </div>\n\n        <div class=\"chart-area\">\n            <!-- Y-axis label -->\n            <div class=\"y-axis-label\" style=\"transform: translate(-127.337px, -2.74432px);\">Success Rate (%)</div>\n\n            <!-- Y-axis ticks (range 20-50, 900px height, scale: 900/30 = 30px per unit) -->\n            <div class=\"y-axis\">\n                <div class=\"y-tick\" style=\"bottom: 0px;\">20</div>\n                <div class=\"y-tick\" style=\"bottom: 150px;\">25</div>\n                <div class=\"y-tick\" style=\"bottom: 300px;\">30</div>\n                <div class=\"y-tick\" style=\"bottom: 450px;\">35</div>\n                <div class=\"y-tick\" style=\"bottom: 600px;\">40</div>\n                <div class=\"y-tick\" style=\"bottom: 750px;\">45</div>\n                <div class=\"y-tick\" style=\"bottom: 900px;\">50</div>\n            </div>\n\n            <!-- Cross-Task Group -->\n            <div class=\"bar-group group1\">\n                <!-- MindAct: 36.2, height = (36.2-20)*30 = 486px -->\n                <div class=\"bar\" style=\"height: 486px;\">\n                    <div class=\"bar-fill\" style=\"background-color: #888888;\"></div>\n                    <div class=\"bar-value\">36.2</div>\n                </div>\n                <!-- AWM-offline: 45.1, height = (45.1-20)*30 = 753px -->\n                <div class=\"bar\" style=\"height: 753px;\">\n                    <div class=\"bar-fill\" style=\"background-color: #5CB85C;\"></div>\n                    <div class=\"bar-value\">45.1</div>\n                </div>\n                <!-- AWM-online: 43.6, height = (43.6-20)*30 = 708px -->\n                <div class=\"bar\" style=\"height: 708px;\">\n                    <div class=\"bar-fill\" style=\"background-color: #2E7D32;\"></div>\n                    <div class=\"bar-value\">43.6</div>\n                </div>\n            </div>\n\n            <!-- Cross-Website Group -->\n            <div class=\"bar-group group2\">\n                <!-- MindAct: 30.1, height = (30.1-20)*30 = 303px -->\n                <div class=\"bar\" style=\"height: 303px;\">\n                    <div class=\"bar-fill\" style=\"background-color: #888888;\"></div>\n                    <div class=\"bar-value\">30.1</div>\n                </div>\n                <!-- AWM-offline: 33.7, height = (33.7-20)*30 = 411px -->\n                <div class=\"bar\" style=\"height: 411px;\">\n                    <div class=\"bar-fill\" style=\"background-color: #5CB85C;\"></div>\n                    <div class=\"bar-value\">33.7</div>\n                </div>\n                <!-- AWM-online: 33.9, height = (33.9-20)*30 = 417px -->\n                <div class=\"bar\" style=\"height: 417px;\">\n                    <div class=\"bar-fill\" style=\"background-color: #2E7D32;\"></div>\n                    <div class=\"bar-value\">33.9</div>\n                </div>\n            </div>\n\n            <!-- Cross-Domain Group -->\n            <div class=\"bar-group group3\">\n                <!-- MindAct: 26.4, height = (26.4-20)*30 = 192px -->\n                <div class=\"bar\" style=\"height: 192px;\">\n                    <div class=\"bar-fill\" style=\"background-color: #888888;\"></div>\n                    <div class=\"bar-value\">26.4</div>\n                </div>\n                <!-- AWM-offline: 32.6, height = (32.6-20)*30 = 378px -->\n                <div class=\"bar\" style=\"height: 378px;\">\n                    <div class=\"bar-fill\" style=\"background-color: #5CB85C;\"></div>\n                    <div class=\"bar-value\">32.6</div>\n                </div>\n                <!-- AWM-online: 35.5, height = (35.5-20)*30 = 465px -->\n                <div class=\"bar\" style=\"height: 465px;\">\n                    <div class=\"bar-fill\" style=\"background-color: #2E7D32;\"></div>\n                    <div class=\"bar-value\">35.5</div>\n                </div>\n            </div>\n\n         