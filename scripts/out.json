rk green) -->\n            <rect x=\"300\" y=\"83\" width=\"70\" height=\"437\" fill=\"#2E7D32\" class=\"bar\"/>\n            <text x=\"335\" y=\"73\" class=\"value-label\">43.6</text>\n\n            <!-- X-axis label: Cross-Task -->\n            <text x=\"255\" y=\"555\" class=\"axis-text\" text-anchor=\"middle\">Cross-Task</text>\n\n            <!-- Cross-Website Group (centered at x=520) -->\n            <!-- MindAct: 30.1 (gray) -->\n            <rect x=\"440\" y=\"219\" width=\"70\" height=\"301\" fill=\"#888888\" class=\"bar\"/>\n            <text x=\"475\" y=\"209\" class=\"value-label\">30.1</text>\n\n            <!-- AWM-offline: 33.7 (medium green) -->\n            <rect x=\"520\" y=\"183\" width=\"70\" height=\"337\" fill=\"#5CB85C\" class=\"bar\"/>\n            <text x=\"555\" y=\"173\" class=\"value-label\">33.7</text>\n\n            <!-- AWM-online: 33.9 (dark green) -->\n            <rect x=\"600\" y=\"181\" width=\"70\" height=\"339\" fill=\"#2E7D32\" class=\"bar\"/>\n            <text x=\"635\" y=\"171\" class=\"value-label\">33.9</text>\n\n            <!-- X-axis label: Cross-Website -->\n            <text x=\"555\" y=\"555\" class=\"axis-text\" text-anchor=\"middle\">Cross-Website</text>\n\n            <!-- Cross-Domain Group (centered at x=820) -->\n            <!-- MindAct: 26.4 (gray) -->\n            <rect x=\"740\" y=\"256\" width=\"70\" height=\"264\" fill=\"#888888\" class=\"bar\"/>\n            <text x=\"775\" y=\"246\" class=\"value-label\">26.4</text>\n\n            <!-- AWM-offline: 32.6 (medium green) -->\n            <rect x=\"820\" y=\"194\" width=\"70\" height=\"326\" fill=\"#5CB85C\" class=\"bar\"/>\n            <text x=\"855\" y=\"184\" class=\"value-label\">32.6</text>\n\n            <!-- AWM-online: 35.5 (dark green) -->\n            <rect x=\"900\" y=\"165\" width=\"70\" height=\"355\" fill=\"#2E7D32\" class=\"bar\"/>\n            <text x=\"935\" y=\"155\" class=\"value-label\">35.5</text>\n\n            <!-- X-axis label: Cross-Domain -->\n            <text x=\"855\" y=\"555\" class=\"axis-text\" text-anchor=\"middle\">Cross-Domain</text>\n\n            <!-- Legend -->\n            <g transform=\"translate(980, 80)\">\n                <!-- MindAct -->\n                <rect x=\"0\" y=\"0\" width=\"20\" height=\"20\" fill=\"#888888\"/>\n                <text x=\"28\" y=\"15\" class=\"legend-text\">MindAct</text>\n\n                <!-- AWM-offline -->\n                <rect x=\"0\" y=\"30\" width=\"20\" height=\"20\" fill=\"#5CB85C\"/>\n                <text x=\"28\" y=\"45\" class=\"legend-text\">AWM-offline</text>\n\n                <!-- AWM-online -->\n                <rect x=\"0\" y=\"60\" width=\"20\" height=\"20\" fill=\"#2E7D32\"/>\n                <text x=\"28\" y=\"75\" class=\"legend-text\">AWM-online</text>\n            </g>\n        </svg>\n    </div>\n</body>\n</html>\n",
