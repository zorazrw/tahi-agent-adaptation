ss=\"value-label\">36.2</text>\n\n            <!-- AWM-offline: 45.1 -> y position = 520 - (45.1-20)*16.67 = 520 - 418.3 = 101.7, height = 418.3 -->\n            <rect x=\"220\" y=\"101.7\" width=\"70\" height=\"418.3\" fill=\"#5CB85C\" class=\"bar\"/>\n            <text x=\"255\" y=\"91.7\" class=\"value-label\">45.1</text>\n\n            <!-- AWM-online: 43.6 -> y position = 520 - (43.6-20)*16.67 = 520 - 393.3 = 126.7, height = 393.3 -->\n            <rect x=\"300\" y=\"126.7\" width=\"70\" height=\"393.3\" fill=\"#2E7D32\" class=\"bar\"/>\n            <text x=\"335\" y=\"116.7\" class=\"value-label\">43.6</text>\n\n            <!-- X-axis label: Cross-Task -->\n            <text x=\"255\" y=\"555\" class=\"axis-text\" text-anchor=\"middle\">Cross-Task</text>\n\n            <!-- Cross-Website Group -->\n            <!-- MindAct: 30.1 -> y position = 520 - (30.1-20)*16.67 = 520 - 168.3 = 351.7, height = 168.3 -->\n            <rect x=\"440\" y=\"351.7\" width=\"70\" height=\"168.3\" fill=\"#888888\" class=\"bar\"/>\n            <text x=\"475\" y=\"341.7\" class=\"value-label\">30.1</text>\n\n            <!-- AWM-offline: 33.7 -> y position = 520 - (33.7-20)*16.67 = 520 - 228.3 = 291.7, height = 228.3 -->\n            <rect x=\"520\" y=\"291.7\" width=\"70\" height=\"228.3\" fill=\"#5CB85C\" class=\"bar\"/>\n            <text x=\"555\" y=\"281.7\" class=\"value-label\">33.7</text>\n\n            <!-- AWM-online: 33.9 -> y position = 520 - (33.9-20)*16.67 = 520 - 231.7 = 288.3, height = 231.7 -->\n            <rect x=\"600\" y=\"288.3\" width=\"70\" height=\"231.7\" fill=\"#2E7D32\" class=\"bar\"/>\n            <text x=\"635\" y=\"278.3\" class=\"value-label\">33.9</text>\n\n            <!-- X-axis label: Cross-Website -->\n            <text x=\"555\" y=\"555\" class=\"axis-text\" text-anchor=\"middle\">Cross-Website</text>\n\n            <!-- Cross-Domain Group -->\n            <!-- MindAct: 26.4 -> y position = 520 - (26.4-20)*16.67 = 520 - 106.7 = 413.3, height = 106.7 -->\n            <rect x=\"740\" y=\"413.3\" width=\"70\" height=\"106.7\" fill=\"#888888\" class=\"bar\"/>\n            <text x=\"775\" y=\"403.3\" class=\"value-label\">26.4</text>\n\n            <!-- AWM-offline: 32.6 -> y position = 520 - (32.6-20)*16.67 = 520 - 210 = 310, height = 210 -->\n            <rect x=\"820\" y=\"310\" width=\"70\" height=\"210\" fill=\"#5CB85C\" class=\"bar\"/>\n            <text x=\"855\" y=\"300\" class=\"value-label\">32.6</text>\n\n            <!-- AWM-online: 35.5 -> y position = 520 - (35.5-20)*16.67 = 520 - 258.3 = 261.7, height = 258.3 -->\n            <rect x=\"900\" y=\"261.7\" width=\"70\" height=\"258.3\" fill=\"#2E7D32\" class=\"bar\"/>\n            <text x=\"935\" y=\"251.7\" class=\"value-label\">35.5</text>\n\n            <!-- X-axis label: Cross-Domain -->\n            <text x=\"855\" y=\"555\" class=\"axis-text\" text-anchor=\"middle\">Cross-Domain</text>\n\n            <!-- Legend -->\n            <g transform=\"translate(980, 80)\">\n                <!-- MindAct -->\n                <rect x=\"0\" y=\"0\" width=\"20\" height=\"20\" fill=\"#888888\"/>\n                <text x=\"28\" y=\"15\" class=\"legend-text\">MindAct</text>\n\n                <!-- AWM-offline -->\n                <rect x=\"0\" y=\"30\" width=\"20\" height=\"20\" fill=\"#5CB85C\"/>\n                <text x=\"28\" y=\"45\" class=\"legend-text\">AWM-offline</text>\n\n                <!-- AWM-online -->\n                <rect x=\"0\" y=\"60\" width=\"20\" height=\"20\" fill=\"#2E7D32\"/>\n                <text x=\"28\" y=\"75\" class=\"legend-text\">AWM-online</text>\n            </g>\n        </svg>\n    </div>\n</body>\n</html>\n",
