\"end\">20</text>\n            <text class=\"value-label\" x=\"130\" y=\"385\" text-anchor=\"end\">40</text>\n            <text class=\"value-label\" x=\"130\" y=\"235\" text-anchor=\"end\">60</text>\n            <text class=\"value-label\" x=\"130\" y=\"85\" text-anchor=\"end\">80</text>\n\n            <!-- All 31 data points plotted chronologically as scatter plot\n                 X-axis: 33 months from Mar 2023 to Dec 2025\n                 X position = 150 + (month_index / 33) * 1370\n                 Y position = 680 - (score / 80) * 600\n            -->\n\n            <!-- Data point circles (all 31 points) -->\n            <circle class=\"data-point\" cx=\"150\" cy=\"613.4\" r=\"5\" />\n            <circle class=\"data-point\" cx=\"223.6\" cy=\"592.3\" r=\"5\" />\n            <circle class=\"data-point\" cx=\"223.6\" cy=\"568.8\" r=\"5\" />\n            <circle class=\"data-point\" cx=\"297.3\" cy=\"626.4\" r=\"5\" />\n            <circle class=\"data-point\" cx=\"371\" cy=\"626.6\" r=\"5\" />\n            <circle class=\"data-point\" cx=\"444.6\" cy=\"627.4\" r=\"5\" />\n            <circle class=\"data-point\" cx=\"444.6\" cy=\"566.4\" r=\"5\" />\n            <circle class=\"data-point\" cx=\"444.6\" cy=\"528.5\" r=\"5\" />\n            <circle class=\"data-point\" cx=\"444.6\" cy=\"503.9\" r=\"5\" />\n            <circle class=\"data-point\" cx=\"444.6\" cy=\"428.1\" r=\"5\" />\n            <circle class=\"data-point\" cx=\"518.3\" cy=\"609.8\" r=\"5\" />\n            <circle class=\"data-point\" cx=\"518.3\" cy=\"581.8\" r=\"5\" />\n            <circle class=\"data-point\" cx=\"592\" cy=\"535.6\" r=\"5\" />\n            <circle class=\"data-point\" cx=\"665.6\" cy=\"401.6\" r=\"5\" />\n            <circle class=\"data-point\" cx=\"665.6\" cy=\"252.9\" r=\"5\" />\n            <circle class=\"data-point\" cx=\"739.3\" cy=\"414.4\" r=\"5\" />\n            <circle class=\"data-point\" cx=\"813\" cy=\"235.7\" r=\"5\" />\n            <circle class=\"data-point