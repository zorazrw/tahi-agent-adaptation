>\n            <circle class=\"data-point\" cx=\"665.6\" cy=\"252.9\" r=\"10\" />\n            <circle class=\"data-point\" cx=\"739.3\" cy=\"414.4\" r=\"10\" />\n            <circle class=\"data-point\" cx=\"813\" cy=\"235.7\" r=\"10\" />\n            <circle class=\"data-point\" cx=\"813\" cy=\"414.9\" r=\"10\" />\n            <circle class=\"data-point\" cx=\"813\" cy=\"337.1\" r=\"10\" />\n            <circle class=\"data-point\" cx=\"886.6\" cy=\"282.8\" r=\"10\" />\n            <circle class=\"data-point\" cx=\"960.3\" cy=\"557.6\" r=\"10\" />\n            <circle class=\"data-point\" cx=\"960.3\" cy=\"512.1\" r=\"10\" />\n            <circle class=\"data-point\" cx=\"960.3\" cy=\"320\" r=\"10\" />\n            <circle class=\"data-point\" cx=\"960.3\" cy=\"290.4\" r=\"10\" />\n            <circle class=\"data-point\" cx=\"960.3\" cy=\"248.4\" r=\"10\" />\n            <circle class=\"data-point\" cx=\"1034\" cy=\"218.2\" r=\"10\" />\n            <circle class=\"data-point\" cx=\"1107.6\" cy=\"446.8\" r=\"10\" />\n            <circle class=\"data-point\" cx=\"1181.3\" cy=\"179.7\" r=\"10\" />\n            <circle class=\"data-point\" cx=\"1255\" cy=\"161.9\" r=\"10\" />\n            <circle class=\"data-point\" cx=\"1255\" cy=\"269.8\" r=\"10\" />\n            <circle class=\"data-point\" cx=\"1328.6\" cy=\"146.6\" r=\"10\" />\n            <circle class=\"data-point\" cx=\"1328.6\" cy=\"86.5\" r=\"10\" />\n\n            <!-- X-axis date labels (6 selected to avoid overlap) -->\n            <text class=\"axis-label\" x=\"150\" y=\"740\" text-anchor=\"middle\">Mar</text>\n            <text class=\"axis-label\" x=\"150\" y=\"790\" text-anchor=\"middle\">2023</text>\n\n            <text class=\"axis-label\" x=\"371\" y=\"740\" text-anchor=\"middle\">Sep</text>\n            <text class=\"axis-label\" x=\"371\" y=\"790\" text-anchor=\"middle\">2023</text>\n\n            <text class=\"axis-label\" x=\"592\" y=\"740\" text-anchor=\"middle\">Apr</text>\n            <text class=\"axis-label\" x=\"592\" y=\"790\" text-anchor=\"middle\">2024</text>\n\n            <text class=\"axis-label\" x=\"813\" y=\"740\" text-anchor=\"middle\">Oct</text>\n            <text class=\"axis-label\" x=\"813\" y=\"790\" text-anchor=\"middle\">2024</text>\n\n            <text class=\"axis-label\" x=\"1034\" y=\"740\" text-anchor=\"middle\">Feb</text>\n            <text class=\"axis-label\" x=\"1034\" y=\"790\" text-anchor=\"middle\">2025</text>\n\n            <text class=\"axis-label\" x=\"1328.6\" y=\"740\" text-anchor=\"middle\">Dec</text>\n            <text class=\"axis-label\" x=\"1328.6\" y=\"790\" text-anchor=\"middle\">2025</text>\n        </svg>\n    </div>\n</body>\n</html>\n",
