              "content": "<!DOCTYPE html>\n<html lang=\"en\"><head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>Mind2Web Dataset Results</title>\n    <style>\n        body {\n            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, sans-serif;\n            margin: 0;\n            padding: 60px;\n            background-color: #ffffff;\n        }\n\n        .chart-container {\n            max-width: 1600px;\n            margin: 0 auto;\n        }\n\n        .chart-title {\n            font-size: 72px;\n            font-weight: bold;\n            text-align: center;\n            margin-bottom: 30px;\n            color: #333;\n        }\n\n        .legend {\n            display: flex;\n            justify-content: space-between;\n            margin-bottom: 50px;\n            margin-left: 240px;\n            width: 1100px;\n            padding-left: 120px;\n            padding-right: 120px;\n        }\n\n        .legend-item {\n            display: flex;\n            align-items: center;\n            gap: 18px;\n            font-size: 42px;\n            color: #333;\n        }\n\n        .legend-color {\n            width: 45px;\n            height: 45px;\n        }\n\n        .chart-area {\n            position: relative;\n            height: 500px;\n            border-left: 4px solid #333;\n            border-bottom: 4px solid #333;\n            margin-left: 240px;\n            margin-right: 100px;\n            width: 1100px;\n        }\n\n        .y-axis {\n            position: absolute;\n            left: -160px;\n            top: 0;\n            width: 140px;\n            height: 100%;\n        }\n\n        .y-tick {\n            position: absolute;\n            right: 0;\n            width: 100%;\n            text-align: right;\n            font-size: 42px;\n            color: #333;\n            padding-right: 20px;\n        }\n\n        .x-axis {\n            position: absolute;\n            bottom: -90px;\n            left: 0;\n            width: 100%;\n            height: 80px;\n        }\n\n        .x-label {\n            position: absolute;\n            font-size: 42px;\n            color: #333;\n            font-weight: 500;\n            text-align: center;\n            line-height: 1.2;\n        }\n\n        .y-axis-label {\n            position: absolute;\n            left: -180px;\n            top: 250px;\n            transform: rotate(-90deg);\n            transform-origin: center center;\n            font-size: 42px;\n            color: #333;\n            white-space: nowrap;\n        }\n\n        .bar-group {\n            position: absolute;\n            bottom: 0;\n            display: flex;\n            gap: 10px;\n            align-items: flex-end;\n        }\n\n        .bar {\n            width: 70px;\n            position: relative;\n            transition: opacity 0.2s;\n        }\n\n        .bar:hover {\n            opacity: 0.8;\n        }\n\n        .bar-fill {\n            width: 100%;\n            height: 100%;\n        }\n\n        .bar-value {\n            position: absolute;\n            top: -50px;\n            left: 50%;\n            transform: translateX(-50%);\n            font-size: 38px;\n            font-weight: 600;\n            color: #333;\n            white-space: nowrap;\n        }\n\n        .group1 { left: 120px; }\n        .group2 { left: 450px; }\n        .group3 { left: 780px; }\n    </style>\n</head>\n<body class=\"layout-mode\" contenteditable=\"false\">\n    <div class=\"chart-container\" style=\"position: relative;\">\n        <div class=\"chart-title\">Mind2Web</div>\n\n        <div class=\"legend\">\n            <div class=\"legend-item\">\n                <div class=\"legend-color\" style=\"background-color: #888888;\"></div>\n                <span>MindAct</span>\n            </div>\n            <div class=\"legend-item\" style=\"position: relative; 