              "path": "webarena_benchmark.html",
              "content": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>WebArena Benchmark Results</title>\n    <style>\n        * {\n            margin: 0;\n            padding: 0;\n            box-sizing: border-box;\n        }\n\n        body {\n            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;\n            background: #ffffff;\n            padding: 20px;\n            display: flex;\n            justify-content: center;\n            align-items: center;\n            min-height: 100vh;\n        }\n\n        .container {\n            background: white;\n            max-width: 700px;\n            width: 100%;\n        }\n\n        .chart-container {\n            position: relative;\n            width: 100%;\n            height: 400px;\n        }\n\n        .bar {\n            transition: all 0.3s ease;\n            cursor: pointer;\n        }\n\n        .bar:hover {\n            opacity: 0.85;\n        }\n\n        .bar-label {\n            font-size: 18px;\n            fill: #333;\n            font-weight: 500;\n        }\n\n        .axis-label {\n            font-size: 16px;\n            fill: #666;\n        }\n\n        .axis-title {\n            font-size: 18px;\n            fill: #333;\n            font-weight: 500;\n        }\n\n        .grid-line {\n            stroke: #e0e0e0;\n            stroke-width: 1;\n        }\n\n        .value-label {\n            font-size: 20px;\n            font-weight: 600;\n            fill: #333;\n        }\n\n        .tooltip {\n            position: absolute;\n            background: rgba(0, 0, 0, 0.9);\n            color: white;\n            padding: 8px 12px;\n            border-radius: 6px;\n            font-size: 13px;\n            pointer-events: none;\n            opacity: 0;\n            transition: opacity 0.2s;\n            white-space: nowrap;\n        }\n    </style>\n</head>\n<body>\n    <div class=\"container\">\n        <div class=\"chart-container\">\n            <svg id=\"chart\" width=\"100%\" height=\"100%\" viewBox=\"0 0 700 380\">\n                <!-- Y-axis labels -->\n                <text class=\"axis-label\" x=\"70\" y=\"305\" text-anchor=\"end\">0</text>\n                <text class=\"axis-label\" x=\"70\" y=\"237\" text-anchor=\"end\">10</text>\n                <text class=\"axis-label\" x=\"70\" y=\"169\" text-anchor=\"end\">20</text>\n                <text class=\"axis-label\" x=\"70\" y=\"101\" text-anchor=\"end\">30</text>\n                <text class=\"axis-label\" x=\"70\" y=\"34\" text-anchor=\"end\">40</text>\n\n                <!-- Y-axis title -->\n                <text class=\"axis-title\" x=\"20\" y=\"165\" text-anchor=\"middle\" transform=\"rotate(-90 20 165)\">Success Rate (%)</text>\n\n                <!-- Bars - Ordered from highest to lowest performance -->\n                <!-- AWM (Our Method) - BEST PERFORMER -->\n                <rect class=\"bar\" data-name=\"AWM\" data-value=\"35.5\" data-category=\"Our Method\"\n                      x=\"110\" y=\"34.125\" width=\"70\" height=\"265.875\"\n                      fill=\"#4CAF50\" rx=\"4\"/>\n                <text class=\"value-label\" x=\"145\" y=\"20\" text-anchor=\"middle\" font-weight=\"700\">35.5</text>\n                <text class=\"bar-label\" x=\"145\" y=\"330\" text-anchor=\"middle\" font-weight=\"700\">AWM (Ours)</text>\n\n                <!-- Step (Human) - 2nd PLACE -->\n                <rect class=\"bar\" data-name=\"Step\" data-value=\"33.0\" data-category=\"Human Baseline\"\n                      x=\"210\" y=\"55.5\" width=\"70\" height=\"244.5\"\n                      fill=\"#78909C\" rx=\"4\"/>\n                <text class=\"value-label\" x=\"245\" y=\"41\" text-anchor=\"middle\">33.0</text>\n                <text class=\"bar-label\" x=\"245\" y=\"330\" text-anchor=\"middle\">Step</text>\n                <text class=\"bar-label\" x=\"245\" y=\"350\" text-anchor=\"middle\">(Human)</text>\n\n                <!-- BrowserGym - 3rd PLACE -->\n                <rect class=\"bar\" data-name=\"BrowserGym\" data-value=\"23.5\" data-category=\"Baseline Method\"\n                      x=\"310\" y=\"127.125\" width=\"70\" height=\"172.875\"\n                      fill=\"#9E9E9E\" rx=\"4\"/>\n                <text class=\"value-label\" x=\"345\" y=\"113\" text-anchor=\"middle\">23.5</text>\n                <text class=\"bar-label\" x=\"345\" y=\"330\" text-anchor=\"middle\">BrowserGym</text>\n\n                <!-- AutoEval - 4th PLACE -->\n                <rect class=\"bar\" data-name=\"AutoEval\" data-value=\"20.2\" data-category=\"Baseline Method\"\n                      x=\"410\" y=\"154.6\" width=\"70\" height=\"145.4\"\n                      fill=\"#9E9E9E\" rx=\"4\"/>\n                <text class=\"value-label\" x=\"445\" y=\"140\" text-anchor=\"middle\">20.2</text>\n                <text class=\"bar-label\" x=\"445\" y=\"330\" text-anchor=\"middle\">AutoEval</text>\n\n                <!-- BrowserGym axtree - 5th PLACE -->\n                <rect class=\"bar\" data-name=\"BrowserGym axtree\" data-value=\"15.0\" data-category=\"Baseline Method\"\n                      x=\"510\" y=\"199.5\" width=\"70\" height=\"100.5\"\n                      fill=\"#9E9E9E\" rx=\"4\"/>\n                <text class=\"value-label\" x=\"545\" y=\"185\" text-anchor=\"middle\">15.0</text>\n                <text class=\"bar-label\" x=\"545\" y=\"330\" text-anchor=\"middle\">BrowserGym</text>\n                <text class=\"bar-label\" x=\"545\" y=\"350\" text-anchor=\"middle\">axtree</text>\n\n                <!-- GPT-4o - 6th PLACE -->\n                <rect class=\"bar\" data-name=\"GPT-4o\" data-value=\"14.9\" data-category=\"Baseline Method\"\n                      x=\"610\" y=\"199.775\" width=\"70\" height=\"100.225\"\n                      fill=\"#9E9E9E\" rx=\"4\"/>\n                <text class=\"value-label\" x=\"645\" y=\"185\" text-anchor=\"middle\">14.9</text>\n                <text class=\"bar-label\" x=\"645\" y=\"330\" text-anchor=\"middle\">GPT-4o</text>\n            </svg>\n\n            <div class=\"tooltip\" id=\"tooltip\"></div>\n        </div>\n    </div>\n\n    <script>\n        // Interactive hover effects\n        const bars = document.querySelectorAll('.bar');\n        const tooltip = document.getElementById('tooltip');\n\n        bars.forEach(bar => {\n            bar.addEventListener('mouseenter', (e) => {\n                const name = bar.getAttribute('data-name');\n                const value = bar.getAttribute('data-value');\n                const category = bar.getAttribute('data-category');\n\n                tooltip.innerHTML = `<strong>${name}</strong><br>${category}<br>Success Rate: ${value}%`;\n                tooltip.style.opacity = '1';\n            });\n\n            bar.addEventListener('mousemove', (e) => {\n                const rect = document.querySelector('.container').getBoundingClientRect();\n                tooltip.style.left = (e.clientX - rect.left + 15) + 'px';\n                tooltip.style.top = (e.clientY - rect.top - 15) + 'px';\n            });\n\n            bar.addEventListener('mouseleave', () => {\n                tooltip.style.opacity = '0';\n            });\n        });\n    </script>\n</body>\n</html>\n",
