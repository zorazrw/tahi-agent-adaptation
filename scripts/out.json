.x-axis {\n            position: absolute;\n            bottom: -90px;\n            left: 0;\n            width: 100%;\n            height: 80px;\n        }\n\n        .x-label {\n            position: absolute;\n            font-size: 42px;\n            color: #333;\n            font-weight: 500;\n            text-align: center;\n        }\n\n        .y-axis-label {\n            position: absolute;\n            left: -240px;\n            top: 50%;\n            transform-origin: center center;\n            transform: translateY(-50%) rotate(-90deg);\n            font-size: 42px;\n            color: #333;\n            white-space: nowrap;\n        }\n\n        .bar-group {\n            position: absolute;\n            bottom: 0;\n            display: flex;\n            gap: 10px;\n            align-items: flex-end;\n        }\n\n        .bar {\n            width: 70px;\n            position: relative;\n            transition: opacity 0.2s;\n        }\n\n        .bar:hover {\n            opacity: 0.8;\n        }\n\n        .bar-fill {\n            width: 100%;\n            height: 100%;\n        }\n\n        .bar-value {\n            position: absolute;\n            top: -50px;\n            left: 50%;\n            transform: translateX(-50%);\n            font-size: 38px;\n            font-weight: 600;\n            color: #333;\n            white-space: nowrap;\n        }\n\n        .group1 { left: 120px; }\n        .group2 { left: 450px; }\n        .group3 { left: 780px; }\n    </style>\n</head>\n<body class=\"\">\n    <div class=\"chart-container\">\n        <div class=\"chart-title\">Mind2Web</div>\n\n        <div class=\"legend\">\n            <div class=\"legend-item\">\n                <div class=\"legend-color\" style=\"background-color: #888888;\"></div>\n                <span>MindAct</span>\n            </div>\n            <div class=\"legend-item\">\n                <div class=\"legend-color\" style=\"background-color: #5CB85C;\"></div>\n                <span>AWM-offline</span>\n            </div>\n            <div class=\"legend-item\">\n                <div class=\"legend-color\" style=\"background-color: #2E7D32;\"></div>\n                <span>AWM-online</span>\n            </div>\n        </div>\n\n        <div class=\"chart-area\">\n            <!-- Y-axis label -->\n            <div class=\"y-axis-label\">Success Rate (%)</div>\n\n            <!-- Y-axis ticks (range 20-50, 500px height, scale: 500/30 = 16.67px per unit) -->\n            <div class=\"y-axis\">\n                <div class=\"y-tick\" style=\"bottom: 0px;\">20</div>\n                <div class=\"y-tick\" style=\"bottom: 83.3px;\">25</div>\n                <div class=\"y-tick\" style=\"bottom: 166.7px;\">30</div>\n                <div class=\"y-tick\" style=\"bottom: 250px;\">35</div>\n                <div class=\"y-tick\" style=\"bottom: 333.3px;\">40</div>\n                <div class=\"y-tick\" style=\"bottom: 416.7px;\">45</div>\n                <div class=\"y-tick\" style=\"bottom: 500px;\">50</div>\n            </div>\n\n            <!-- Cross-Task Group -->\n            <div class=\"bar-group group1\">\n                <!-- MindAct: 36.2, height = (36.2-20)*16.67 = 270px -->\n                <div class=\"bar\" style=\"height: 270px;\">\n                    <div class=\"bar-fill\" style=\"background-color: #888888;\"></div>\n                    <div class=\"bar-value\">36.2</div>\n                </div>\n                <!-- AWM-offline: 45.1, height = (45.1-20)*16.67 = 418px -->\n                <div class=\"bar\" style=\"height: 418px;\">\n                    <div class=\"bar-fill\" style=\"background-color: #5CB85C;\"></div>\n                    <div class=\"bar-value\">45.1</div>\n                </div>\n                <!-- AWM-online: 43.6, height = (43.6-20)*16.67 = 393px -->\n                <div class=\"bar\" style=\"height: 393px;\">\n                    <div class=\"bar-fill\" style=\"background-color: #2E7D32;\"></div>\n                    <div class=\"bar-value\">43.6</div>\n                </div>\n            </div>\n\n            <!-- Cross-Website Group -->\n            <div class=\"bar-group group2\">\n                <!-- MindAct: 30.1, height = (30.1-20)*16.67 = 168px -->\n                <div class=\"bar\" style=\"height: 168px;\">\n                    <div class=\"bar-fill\" style=\"background-color: #888888;\"></div>\n                    <div class=\"bar-value\">30.1</div>\n                </div>\n                <!-- AWM-offline: 33.7, height = (33.7-20)*16.67 = 228px -->\n                <div class=\"bar\" style=\"height: 228px;\">\n                    <div class=\"bar-fill\" style=\"background-color: #5CB85C;\"></div>\n                    <div class=\"bar-value\">33.7</div>\n                </div>\n                <!-- AWM-online: 33.9, height = (33.9-20)*16.67 = 232px -->\n                <div class=\"bar\" style=\"height: 232px;\">\n                    <div class=\"bar-fill\" style=\"background-color: #2E7D32;\"></div>\n                    <div class=\"bar-value\">33.9</div>\n                </div>\n            </div>\n\n            <!-- Cross-Domain Group -->\n            <div class=\"bar-group group3\">\n                <!-- MindAct: 26.4, height = (26.4-20)*16.67 = 107px -->\n                <div class=\"bar\" style=\"height: 107px;\">\n                    <div class=\"bar-fill\" style=\"background-color: #888888;\"></div>\n                    <div class=\"bar-value\">26.4</div>\n                </div>\n                <!-- AWM-offline: 32.6, height = (32.6-20)*16.67 = 210px -->\n                <div class=\"bar\" style=\"height: 210px;\">\n                    <div class=\"bar-fill\" style=\"background-color: #5CB85C;\"></div>\n                    <div class=\"bar-value\">32.6</div>\n                </div>\n                <!-- AWM-online: 35.5, height = (35.5-20)*16.67 = 258px -->\n                <div class=\"bar\" style=\"height: 258px;\">\n                    <div class=\"bar-fill\" style=\"background-color: #2E7D32;\"></div>\n                    <div class=\"bar-value\">35.5</div>\n                </div>\n            </div>\n\n            <!-- X-axis labels -->\n            <div class=\"x-axis\">\n                <div class=\"x-label\" style=\"left: 120px; width: 250px;\">Cross-Task</div>\n                <div class=\"x-label\" style=\"left: 450px; width: 250px;\">Cross-Website</div>\n                <div class=\"x-label\" style=\"left: 780px; width: 250px;\">Cross-Domain</div>\n            </div>\n        </div>\n    </div>\n\n\n</body></html>",
