{
    "appId": "com.devagentforge.agentcowork",
    "productName": "Agent Cowork",
    "files": [
        "dist-electron",
        "dist-react"
    ],
    "extraResources": [
        "dist-electron/preload.cjs",
        {
            "from": "scripts",
            "to": "scripts",
            "filter": ["**/*"]
        },
        {
            "from": "tinker-bridge",
            "to": "tinker-bridge",
            "filter": ["**/*", "!.venv/**", "!**/__pycache__/**", "!**/*.pyc"]
        }
    ],
    "icon": "./claude-color.png",
    "mac": {
        "target": "dmg"
    },
    "linux": {
        "target": "AppImage",
        "category": "Utility"
    },
    "win": {
        "target": [
            "portable"
        ]
    }
}
